# Stripe Configuration
# These will be set in sst-backend/.env and passed to the Next.js site during SST deployment
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_PRICE_ID=price_your_price_id_here

# Note: Base URL is automatically determined from the request origin
# SST will deploy this site to AWS (S3 + CloudFront) and provide the URL

# Production values (set in sst-backend/.env):
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
# STRIPE_PRICE_ID=price_your_live_price_id
